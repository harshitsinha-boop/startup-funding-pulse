# Gemini (all AI tasks). Default: latest stable Flash (GA per ai.google.dev, Oct 2026)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Resend
RESEND_API_KEY=
BRIEF_TO_EMAIL=
BRIEF_FROM_EMAIL=onboarding@resend.dev
# Security
CRON_SECRET=
ADMIN_PASSCODE=
